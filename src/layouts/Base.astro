---
// Shared page shell: head, header, footer (spec: PROD-2, PROD-4, PROD-29, PROD-34, I18N-6).
import { Font } from "astro:assets";
import LanguagePicker from "../components/LanguagePicker.astro";
import { REPOSITORY } from "../data/site.ts";
import { fontStacks } from "../i18n/fonts.ts";
import { DEFAULT_LOCALE, getLocale, LOCALES, type LocaleSegment } from "../i18n/locales.ts";
import { createT } from "../i18n/t.ts";
import "../styles/global.css";

interface Props {
  locale: LocaleSegment;
  /** Page title without the site name. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Site path of the Open Graph image, for example a kit cover (PROD-29). */
  image?: string | undefined;
  /** Keep the page out of search results (not-found pages). */
  noindex?: boolean;
  /** Fill the viewport with a one-line footer; the page scrolls only when its content cannot fit (records page, PROD-13a). */
  fill?: boolean;
}

const { locale, title, description, image, noindex = false, fill = false } = Astro.props;
const t = createT(locale);
const { tag, script } = getLocale(locale);

// I18N-19: the Latin faces plus this page's script group (/fonts/{group}.css), and the font stacks.
const fontStyle = Object.entries(fontStacks(script))
  .map(([role, stack]) => `--font-${role}-stack: ${stack}`)
  .join("; ");

// Path after the locale segment: "/en/artists/" → "artists/".
const rest = Astro.url.pathname.split("/").slice(2).join("/");
const site = Astro.site ?? new URL("https://musickitarchive.com");
const urlFor = (segment: LocaleSegment) => new URL(`/${segment}/${rest}`, site).href;

const pageTitle = title ? `${title} · ${t("site.name")}` : t("site.name");
const pageDescription = description ?? t("site.description");
const repository = REPOSITORY;
// GitHub's mark (Octicons "mark-github", MIT).
const githubMark =
  "M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z";
---

<!doctype html>
<html lang={tag} style={fontStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={urlFor(locale)} />
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={l.tag} href={urlFor(l.segment)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE)} />
        </>
      )
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={urlFor(locale)} />
    <meta property="og:locale" content={tag.replace("-", "_")} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Preload the faces every page shows above the fold, so they arrive together and the page is laid out once (PROD-36). */}
    <Font cssVariable="--font-stencil-latin" preload={[{ subset: "latin", weight: 400 }]} />
    <Font cssVariable="--font-condensed-latin" preload={[{ subset: "latin", weight: 600 }, { subset: "latin", weight: 800 }]} />
    <Font cssVariable="--font-mono-latin" preload={[{ subset: "latin", weight: 400 }]} />
    <Font cssVariable="--font-sans-latin" preload={[{ subset: "latin", weight: 400 }]} />
    {script !== "latin" && <link rel="stylesheet" href={`/fonts/${script}.css`} />}
  </head>
  <body class:list={["grid-lines", fill ? "flex h-dvh min-h-fit flex-col" : "min-h-screen"]}>
    <header
      class="relative z-10 flex flex-none min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-rule px-[max(1rem,env(safe-area-inset-left))] py-2 sm:px-10"
    >
      <a href={`/${locale}/`} class="font-stencil text-2xl tracking-wide">CS MUSIC KIT ARCHIVE</a>
      <nav aria-label={t("nav.label")} class="flex flex-wrap items-center justify-end gap-x-3 font-condensed sm:gap-x-7 text-base font-semibold whitespace-nowrap uppercase tracking-widest">
        {
          [
            { href: `/${locale}/`, label: t("nav.records"), current: rest === "" || rest.startsWith("kits/") },
            { href: `/${locale}/artists/`, label: t("nav.artists"), current: rest.startsWith("artists/") },
            { href: `/${locale}/about/`, label: t("nav.about"), current: rest.startsWith("about/") },
          ].map((item) => (
            <a
              href={item.href}
              aria-current={item.current && Astro.url.pathname === item.href ? "page" : undefined}
              class:list={[item.current && "text-signal"]}
            >
              {item.label}
            </a>
          ))
        }
        <div class="border-l border-paper/25 pl-2.5 normal-case tracking-normal">
          <LanguagePicker locale={locale} rest={rest} t={t} />
        </div>
        <a href={repository} class="flex size-11 items-center justify-center hover:text-signal max-sm:hidden">
          <span class="sr-only">GitHub</span>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d={githubMark} /></svg>
        </a>
      </nav>
    </header>

    <main class:list={["relative", fill && "flex flex-1 flex-col"]}>
      <slot />
    </main>

    {
      fill ? (
        <footer class="relative flex-none">
          <div aria-hidden="true" class="hazard h-1.5" />
          <p class="mx-auto my-0 flex max-w-[1360px] flex-wrap items-baseline gap-x-5 gap-y-0.5 px-4 py-2 font-mono text-[11px] leading-snug text-muted sm:px-10">
            <span>{t("footer.short")}</span>
            <a href={repository} class="underline underline-offset-4">
              {t("footer.source")}
            </a>
            <a href={`${repository}/blob/main/NOTICE`} class="underline underline-offset-4">
              {t("footer.licences")}
            </a>
          </p>
        </footer>
      ) : (
        <footer class="relative mt-24">
          <div aria-hidden="true" class="hazard h-3.5" />
          <div class="mx-auto flex max-w-[1360px] flex-col gap-3 px-4 py-10 font-mono text-xs leading-relaxed text-muted sm:px-10">
            <p class="max-w-[72ch]">{t("footer.disclaimer")}</p>
            <p class="max-w-[72ch]">{t("footer.credits")}</p>
            <p class="flex gap-6">
              <a href={repository} class="underline underline-offset-4">
                {t("footer.source")}
              </a>
              <a href={`${repository}/blob/main/NOTICE`} class="underline underline-offset-4">
                {t("footer.licences")}
              </a>
            </p>
          </div>
        </footer>
      )
    }
    {/* PROD-37: Cloudflare Web Analytics, only on the production host, so local runs and previews are not counted. */}
    <script is:inline>
      if (location.hostname === "musickitarchive.com") {
        const beacon = document.createElement("script");
        beacon.defer = true;
        beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
        beacon.dataset.cfBeacon = '{"token": "b5f6a7aebab6436985241f3818c1663a"}';
        document.body.append(beacon);
      }
    </script>
  </body>
</html>
