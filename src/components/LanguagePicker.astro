---
// Language picker (spec: PROD-3, I18N-5). Works without JavaScript; the script only remembers the choice.
import { getLocale, LOCALES, type LocaleSegment } from "../i18n/locales.ts";
import type { Translate } from "../i18n/t.ts";

interface Props {
  locale: LocaleSegment;
  /** Path after the locale segment, for example "artists/". */
  rest: string;
  t: Translate;
}

const { locale, rest, t } = Astro.props;
const current = getLocale(locale);
---

<details class="language-picker relative">
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-2 font-mono text-xs tracking-wide text-paper [&::-webkit-details-marker]:hidden"
    aria-label={`${t("lang.label")}: ${current.name}`}
  >
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.8-9z"></path>
    </svg>
    <span lang={current.tag} class="max-sm:hidden">{current.name}</span>
  </summary>
  <ul
    class="absolute right-0 top-full z-50 mt-2 max-h-[70vh] w-64 overflow-y-auto border border-rule bg-panel py-1.5 font-sans shadow-2xl"
  >
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={`/${l.segment}/${rest}`}
            lang={l.tag}
            hreflang={l.tag}
            data-locale={l.segment}
            aria-current={l.segment === locale ? "page" : undefined}
            class:list={[
              "flex min-h-11 items-center justify-between px-4 text-[15px]",
              l.segment === locale ? "text-signal" : "text-paper",
            ]}
          >
            {l.name}
            {l.segment === locale && <span aria-hidden="true">●</span>}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  import { LOCALE_STORAGE_KEY } from "../i18n/match.ts";

  for (const link of document.querySelectorAll<HTMLAnchorElement>(".language-picker a[data-locale]")) {
    link.addEventListener("click", () => {
      // Keep the selected kit (#slug, PROD-12) and the kit an artist page was opened from (?from=, PROD-21).
      link.search = location.search;
      link.hash = location.hash;
      try {
        localStorage.setItem(LOCALE_STORAGE_KEY, link.dataset.locale ?? "");
      } catch {
        // Storage can be unavailable (private mode). The link still works.
      }
    });
  }
</script>
