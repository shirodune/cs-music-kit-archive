---
// A story (kit page) or introduction (artist page), with its sources under the text (spec: PROD-27, PROD-28,
// I18N-17, I18N-18). Renders nothing when the page has none.

import { getCollection, render } from "astro:content";
import { contentProblems, pickContent } from "../data/content.ts";
import { artists, kits } from "../data/site.ts";
import type { LocaleSegment } from "../i18n/locales.ts";
import { createT } from "../i18n/t.ts";

interface Props {
  collection: "stories" | "introductions";
  slug: string;
  locale: LocaleSegment;
  heading: string;
}

const { collection, slug, locale, heading } = Astro.props;
const t = createT(locale);
const entries = await getCollection(collection);
const slugs = new Set(collection === "stories" ? kits.map((k) => k.slug) : artists.map((a) => a.id));
const problems = contentProblems(collection, entries, slugs);
if (problems.length > 0) throw new Error(problems.join("\n"));

const picked = pickContent(entries, slug, locale);
const rendered = picked ? await render(picked.entry) : null;
const notice = !picked
  ? null
  : picked.untranslated
    ? t("content.untranslated")
    : picked.entry.data.translation === "machine"
      ? t("content.machine")
      : null;
const id = `${collection}-h`;
---

{
  picked && rendered && (
    <section
      aria-labelledby={id}
      data-writing={collection}
      class="relative mx-auto flex max-w-[1360px] flex-wrap gap-x-16 gap-y-4 px-4 pt-22 sm:px-10"
    >
      <div class="flex-[0_0_220px]">
        <h2 id={id} class="font-stencil text-[22px] tracking-wider text-signal uppercase">
          {heading}
        </h2>
        {notice && <p class="mt-3 font-mono text-[11px] leading-relaxed tracking-wider text-muted">{notice}</p>}
      </div>
      <div class="max-w-[720px] min-w-0 flex-[999_1_560px]">
        <div lang={picked.untranslated ? "en" : undefined} class="writing text-lg leading-relaxed text-body">
          <rendered.Content />
        </div>
        <h3 class="mt-10 font-mono text-[11px] tracking-widest text-muted uppercase">{t("content.sources")}</h3>
        <ol class="mt-3 list-decimal pl-5 font-mono text-xs leading-relaxed text-muted">
          {picked.entry.data.sources.map((source) => (
            <li>
              <a href={source.url} class="text-paper underline underline-offset-4">
                {source.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
