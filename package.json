{
  "name": "cs-music-kit-archive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 8787",
    "check": "astro check",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "i18n:check": "node scripts/i18n-check.ts",
    "data:sync": "node scripts/data/sync.ts",
    "data:textures": "node scripts/data/textures.ts",
    "data:covers": "node scripts/data/covers.ts",
    "data:build": "node scripts/data/build.ts",
    "audio:extract": "node scripts/audio/extract.ts",
    "audio:upload": "node scripts/audio/upload.ts",
    "data:verify": "node scripts/data/build.ts && git diff --exit-code --stat -- data/generated",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm check && pnpm i18n:check && pnpm data:verify && pnpm test && pnpm build && pnpm test:e2e",
    "astro": "astro",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.5",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  }
}
